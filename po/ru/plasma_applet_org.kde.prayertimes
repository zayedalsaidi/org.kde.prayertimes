msgstr ""
"Project-Id-Version: org.kde.prayertimes 1.0.0\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-09-21 20:49+0400\n"
"PO-Revision-Date: 2026-09-21 21:20+0400\n"
"Last-Translator: Developer Name <developer@example.com>\n"
"Language-Team: Russian <kde-russian@lists.kde.ru>\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=4; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n"
"%10<=4 && (n%100<12 || n%100>14) ? 1 : n%10==0 || (n%10>=5 && n%10<=9) || (n"
"%100>=11 && n%100<=14)? 2 : 3);\n"

#: ../contents/ui/configGeneral.qml:53 ../contents/ui/Old_configGeneral.qml:62
#, kde-format
msgid "Location"
msgstr "Местоположение"

#: ../contents/ui/configGeneral.qml:54 ../contents/ui/Old_configGeneral.qml:63
#, kde-format
msgid "Appearance"
msgstr "Внешний вид"

#: ../contents/ui/configGeneral.qml:55 ../contents/ui/Old_configGeneral.qml:64
#, kde-format
msgid "Calculation"
msgstr "Расчёт"

#: ../contents/ui/configGeneral.qml:56 ../contents/ui/Old_configGeneral.qml:65
#, kde-format
msgid "About"
msgstr "О программе"

#: ../contents/ui/configGeneral.qml:70 ../contents/ui/Old_configGeneral.qml:115
#, kde-format
msgid "Location Source:"
msgstr "Источник местоположения:"

#: ../contents/ui/configGeneral.qml:70 ../contents/ui/Old_configGeneral.qml:116
#, kde-format
msgid "Use system location services (Recommended)"
msgstr "Использовать системные службы геолокации (Рекомендуется)"

#: ../contents/ui/configGeneral.qml:71 ../contents/ui/Old_configGeneral.qml:120
#, kde-format
msgid "Latitude:"
msgstr "Широта:"

#: ../contents/ui/configGeneral.qml:72 ../contents/ui/Old_configGeneral.qml:126
#, kde-format
msgid "Longitude:"
msgstr "Долгота:"

#: ../contents/ui/configGeneral.qml:73
#, kde-format
msgid ""
"💡 Tip: Open Google Maps, right-click on your location, and copy the numbers."
msgstr ""
"💡 Совет: Откройте Google Карты, нажмите правой кнопкой мыши на ваше местоположение и скопируйте координаты."

#: ../contents/ui/configGeneral.qml:84 ../contents/ui/Old_configGeneral.qml:151
#, kde-format
msgid "Time Format:"
msgstr "Формат времени:"

#: ../contents/ui/configGeneral.qml:87 ../contents/ui/Old_configGeneral.qml:155
#, kde-format
msgid "24-hour (e.g., 14:30)"
msgstr "24-часовой (напр., 14:30)"

#: ../contents/ui/configGeneral.qml:88 ../contents/ui/Old_configGeneral.qml:156
#, kde-format
msgid "12-hour with AM/PM (e.g., 02:30 PM)"
msgstr "12-часовой с AM/PM (напр., 02:30 PM)"

#: ../contents/ui/configGeneral.qml:89 ../contents/ui/Old_configGeneral.qml:157
#, kde-format
msgid "12-hour without AM/PM (e.g., 02:30)"
msgstr "12-часовой без AM/PM (напр., 02:30)"

#: ../contents/ui/configGeneral.qml:102
#: ../contents/ui/Old_configGeneral.qml:175
#, kde-format
msgid "Calculation Method:"
msgstr "Метод расчёта:"

#: ../contents/ui/configGeneral.qml:105
#: ../contents/ui/Old_configGeneral.qml:179
#, kde-format
msgid "🇴🇲 Oman (Official Calendar)"
msgstr "🇴🇲 Оман (Официальный календарь)"

#: ../contents/ui/configGeneral.qml:106
#: ../contents/ui/Old_configGeneral.qml:180
#, kde-format
msgid "Muslim World League"
msgstr "Всемирная исламская лига"

#: ../contents/ui/configGeneral.qml:107
#: ../contents/ui/Old_configGeneral.qml:181
#, kde-format
