#: ../contents/ui/configGeneral.qml:141
#: ../contents/ui/Old_configGeneral.qml:223
#, kde-format
msgid "Isha Offset (min):"
msgstr "Смещение Иша (мин):"

#: ../contents/ui/configGeneral.qml:142
#: ../contents/ui/Old_configGeneral.qml:227
#, kde-format
msgid "Custom Calculation Angles"
